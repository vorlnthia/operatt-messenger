<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Conversations3.FullScreen" parent="@style/Theme.Conversations3">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>


    <style name="Theme.Conversations3.SplashScreen" parent="@style/Theme.Conversations3">
        <item name="android:windowBackground">@drawable/background_splash_screen</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="Theme.Conversations3.Dialog" parent="@style/Theme.Conversations3">
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>


    <style name="Theme.Conversations3" parent="Theme.Material3.Light.NoActionBar">
        <item name="windowActionModeOverlay">true</item>
        <item name="colorPrimary">@color/operatt_light_primary</item>
        <item name="colorOnPrimary">@color/operatt_light_onPrimary</item>
        <item name="colorPrimaryContainer">@color/operatt_light_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/operatt_light_onPrimaryContainer</item>
        <item name="colorSecondary">@color/operatt_light_secondary</item>
        <item name="colorOnSecondary">@color/operatt_light_onSecondary</item>
        <item name="colorSecondaryContainer">@color/operatt_light_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/operatt_light_onSecondaryContainer</item>
        <item name="colorTertiary">@color/operatt_light_tertiary</item>
        <item name="colorOnTertiary">@color/operatt_light_onTertiary</item>
        <item name="colorTertiaryContainer">@color/operatt_light_tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/operatt_light_onTertiaryContainer</item>
        <item name="colorError">@color/operatt_light_error</item>
        <item name="colorErrorContainer">@color/operatt_light_errorContainer</item>
        <item name="colorOnError">@color/operatt_light_onError</item>
        <item name="colorOnErrorContainer">@color/operatt_light_onErrorContainer</item>
        <item name="android:colorBackground">@color/operatt_light_background</item>
        <item name="colorOnBackground">@color/operatt_light_onBackground</item>
        <item name="colorSurface">@color/operatt_light_surface</item>
        <item name="colorOnSurface">@color/operatt_light_onSurface</item>
        <item name="colorSurfaceVariant">@color/operatt_light_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/operatt_light_onSurfaceVariant</item>
        <item name="colorOutline">@color/operatt_light_outline</item>
        <item name="colorOutlineVariant">@color/operatt_light_outlineVariant</item>
        <item name="colorOnSurfaceInverse">@color/operatt_light_inverseOnSurface</item>
        <item name="colorSurfaceInverse">@color/operatt_light_inverseSurface</item>
        <item name="colorPrimaryInverse">@color/operatt_light_inversePrimary</item>
        <item name="android:statusBarColor">@color/operatt_light_surface</item>
        <item name="android:navigationBarColor">@color/operatt_light_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="preferenceTheme">@style/MaterialPreferenceThemeOverlay</item>
    </style>

    <style name="Theme.Conversations3.Dark" parent="Theme.Material3.Dark.NoActionBar">
        <item name="windowActionModeOverlay">true</item>
        <item name="colorPrimary">@color/operatt_dark_primary</item>
        <item name="colorOnPrimary">@color/operatt_dark_onPrimary</item>
        <item name="colorPrimaryContainer">@color/operatt_dark_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/operatt_dark_onPrimaryContainer</item>
        <item name="colorSecondary">@color/operatt_dark_secondary</item>
        <item name="colorOnSecondary">@color/operatt_dark_onSecondary</item>
        <item name="colorSecondaryContainer">@color/operatt_dark_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/operatt_dark_onSecondaryContainer</item>
        <item name="colorTertiary">@color/operatt_dark_tertiary</item>
        <item name="colorOnTertiary">@color/operatt_dark_onTertiary</item>
        <item name="colorTertiaryContainer">@color/operatt_dark_tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/operatt_dark_onTertiaryContainer</item>
        <item name="colorError">@color/operatt_dark_error</item>
        <item name="colorErrorContainer">@color/operatt_dark_errorContainer</item>
        <item name="colorOnError">@color/operatt_dark_onError</item>
        <item name="colorOnErrorContainer">@color/operatt_dark_onErrorContainer</item>
        <item name="android:colorBackground">@color/operatt_dark_background</item>
        <item name="colorOnBackground">@color/operatt_dark_onBackground</item>
        <item name="colorSurface">@color/operatt_dark_surface</item>
        <item name="colorOnSurface">@color/operatt_dark_onSurface</item>
        <item name="colorSurfaceVariant">@color/operatt_dark_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/operatt_dark_onSurfaceVariant</item>
        <item name="colorOutline">@color/operatt_dark_outline</item>
        <item name="colorOutlineVariant">@color/operatt_dark_outlineVariant</item>
        <item name="colorOnSurfaceInverse">@color/operatt_dark_inverseOnSurface</item>
        <item name="colorSurfaceInverse">@color/operatt_dark_inverseSurface</item>
        <item name="colorPrimaryInverse">@color/operatt_dark_inversePrimary</item>
        <item name="android:statusBarColor">@color/operatt_dark_surface</item>
        <item name="android:navigationBarColor">@color/operatt_dark_surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="preferenceTheme">@style/MaterialPreferenceThemeOverlay</item>
    </style>

    <style name="MaterialPreferenceThemeOverlay" parent="@style/PreferenceThemeOverlay">
        <item name="switchPreferenceCompatStyle">@style/MaterialSwitchPreference</item>
    </style>

    <style name="MaterialSwitchPreference" parent="@style/Preference.SwitchPreferenceCompat.Material">
        <item name="widgetLayout">@layout/preference_material_switch</item>
    </style>

    <style name="Theme.Snikket" parent="Theme.Conversations3">
        <item name="colorSurfaceContainerLowest">@color/operatt_light_surfaceContainerLowest</item>
        <item name="colorSurfaceContainerLow">@color/operatt_light_surfaceContainerLow</item>
        <item name="colorSurfaceContainer">@color/operatt_light_surfaceContainer</item>
        <item name="colorSurfaceContainerHigh">@color/operatt_light_surfaceContainerHigh</item>
        <item name="colorSurfaceContainerHighest">@color/operatt_light_surfaceContainerHighest</item>

        <item name="textAppearanceMessageContentNormal">@style/TextAppearance.Snikket.MessageContentNormal</item>
        <item name="textAppearanceMessageContentLarge">@style/TextAppearance.Snikket.MessageContentLarge</item>
    </style>

    <style name="Theme.Snikket.Dark" parent="Theme.Conversations3.Dark">
        <item name="colorSurfaceContainerLowest">@color/operatt_dark_surfaceContainerLowest</item>
        <item name="colorSurfaceContainerLow">@color/operatt_dark_surfaceContainerLow</item>
        <item name="colorSurfaceContainer">@color/operatt_dark_surfaceContainer</item>
        <item name="colorSurfaceContainerHigh">@color/operatt_dark_surfaceContainerHigh</item>
        <item name="colorSurfaceContainerHighest">@color/operatt_dark_surfaceContainerHighest</item>

        <item name="textAppearanceMessageContentNormal">@style/TextAppearance.Snikket.MessageContentNormal</item>
        <item name="textAppearanceMessageContentLarge">@style/TextAppearance.Snikket.MessageContentLarge</item>
    </style>

    <style name="TextAppearance.Snikket.MessageContentNormal" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:letterSpacing">0.002</item>
    </style>

    <style name="TextAppearance.Snikket.MessageContentLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="ShapeAppearance.RoundedCornersBubble" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <!-- 16dp matches drawable/background_message_bubble corner radius -->
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeAppearance.RoundedCornersInsideBubble" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.RoundedCornersMedium" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="ShapeAppearance.RoundedCornersLight" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">6dp</item>
    </style>

    <style name="ShapeAppearance.RoundedCornersVeryLight" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">4dp</item>
    </style>

    <style name="ShapeAppearance.Circular" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>
